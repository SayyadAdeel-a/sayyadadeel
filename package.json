{
  "name": "relab",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app src",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build",
    "verify": "node scripts/qa-all.mjs",
    "verify:all": "node scripts/qa-all.mjs",
    "verify:navigation": "node scripts/verify-navigation.mjs",
    "verify:assets": "node scripts/verify-assets.mjs",
    "verify:route": "node scripts/qa-route.mjs",
    "verify:behavior": "node scripts/qa-behavior.mjs",
    "verify:motion": "node scripts/audit-motion.mjs",
    "verify:reveals": "node scripts/audit-reveals.mjs",
    "verify:hover": "node scripts/audit-hover.mjs",
    "verify:widgets": "node scripts/audit-widgets.mjs",
    "verify:interactions": "node scripts/interaction-inventory.mjs && node scripts/widget-inventory.mjs",
    "verify:coverage": "node scripts/check-coverage.mjs",
    "audit:all": "node scripts/interaction-inventory.mjs && node scripts/widget-inventory.mjs && node scripts/audit-motion.mjs && node scripts/audit-reveals.mjs && node scripts/audit-hover.mjs && node scripts/audit-widgets.mjs && node scripts/check-coverage.mjs",
    "topology": "node scripts/generate-topology.mjs",
    "pipeline:capture": "node scripts/capture-pages.mjs",
    "pipeline:registry": "node scripts/build-routes-registry.mjs",
    "pipeline:assets": "node scripts/download-page-assets.mjs",
    "pipeline:styles": "node scripts/extract-page-styles.mjs",
    "pipeline:convert": "node scripts/convert-page.mjs",
    "pipeline:homepage-dom": "node scripts/compare-dom-shape.mjs 1440 900 && node scripts/compare-dom.mjs --width=1440 --static",
    "pipeline:homepage-behavior": "node scripts/compare-behavior.mjs --width=1440"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.50.0",
    "motion": "^13.5.1",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
