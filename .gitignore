# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# The template is documentation, not a secret: it must be committed.
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local QA server / build logs
/build.log
/start.log
/start.err

# audit / dev-server logs
*.log

# research artefacts: captured reference HTML, IX payloads, QA pixel dumps and
# reference screenshots. The markdown write-ups are committed; the binaries
# (~260 MB) are regenerated locally by the audit scripts.
docs/research/**/qa/
docs/research/**/live-page.html
docs/research/**/webflow-ix2.json
docs/design-references/

# Local server logs from 
pm start / the QA harness.
server.log
server.err
